# Copier ce fichier en .env :  cp .env.example .env
# --- PostgreSQL (Data Warehouse) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_dw
DB_USER=hospital
DB_PASSWORD=hospital

# --- Qualité : taux maximum de valeurs manquantes après nettoyage ---
MAX_MISSING_RATE=0.05

# --- Agent IA (optionnel) ---
# Laisser LLM_PROVIDER vide = mode sans LLM (questions préparées, marche toujours).
# Option GRATUITE : Ollama (LLM local). Installer https://ollama.com puis : ollama pull qwen2.5-coder:7b
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5-coder:7b
# Option Claude (clé payante) : LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY=sk-ant-...
# Option API compatible OpenAI (ex : Groq) : LLM_PROVIDER=openai + LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
ANTHROPIC_API_KEY=

# --- Divers ---
LOG_LEVEL=INFO
# Linux uniquement : mettre votre identifiant (commande `id -u`) pour les droits d'écriture d'Airflow
AIRFLOW_UID=50000
